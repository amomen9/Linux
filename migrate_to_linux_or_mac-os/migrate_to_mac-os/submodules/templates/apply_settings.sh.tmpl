#!/usr/bin/env bash
# =============================================================================
#  apply_settings.sh
#  GENERATED by submodules/D_compile_and_generate_shell_script.ps1 -- do not edit.
#
#  Applies the Windows settings captured in C_windows_configs.csv to macOS.
#  Everything is done with the native macOS tooling -- `defaults`, `networksetup`,
#  `systemsetup`, `pmset`, `sysadminctl`, `socketfilterfw`, `pfctl`, `launchctl`,
#  `lpadmin` and `osascript` -- so it works on every supported macOS release
#  (Catalina 10.15 through the latest) and on both Apple Silicon and Intel.
#  Best-effort: review on first run.
# =============================================================================
### __COMMON__ ###

# Captured Windows settings (injected from C_windows_configs.csv):
### __SETTINGS_DATA__ ###

# WiFi profiles, one per line:  ssid<TAB>auth<TAB>secret<TAB>sectype
#   sectype = enc (secret is an OpenSSL-encrypted, base64 key) | plain | none
# Quoted heredoc so passwords/keys are never shell-expanded.
WIFI_DATA="$(cat <<'__WIFI_EOF__'
### __WIFI_DATA__ ###
__WIFI_EOF__
)"

# Firewall rules, one per line:  name<TAB>dir<TAB>action<TAB>enabled<TAB>proto<TAB>port
FIREWALL_DATA="$(cat <<'__FW_EOF__'
### __FIREWALL_DATA__ ###
__FW_EOF__
)"

# Shortcuts to recreate AFTER apps are installed, one per line:
#   kind<TAB>displayName<TAB>exeBase     (kind = quicklaunch | startmenu | desktop)
SHORTCUTS_DATA="$(cat <<'__SC_EOF__'
### __SHORTCUTS_DATA__ ###
__SC_EOF__
)"

# Windows startup items, one per line:  scope<TAB>name<TAB>exeBase  (scope = user|system)
STARTUP_DATA="$(cat <<'__ST_EOF__'
### __STARTUP_DATA__ ###
__ST_EOF__
)"

# Auto-start third-party Windows services, one per line:  displayName<TAB>serviceName
SERVICES_DATA="$(cat <<'__SV_EOF__'
### __SERVICES_DATA__ ###
__SV_EOF__
)"

# Manually-created Windows scheduled tasks, one per line:
#   name<TAB>scope<TAB>schedule<TAB>exeBase   (scope=user|system; schedule uses commas)
SCHEDTASKS_DATA="$(cat <<'__TK_EOF__'
### __SCHEDTASKS_DATA__ ###
__TK_EOF__
)"

# Custom /etc/hosts lines (verbatim), one per line:
HOSTS_DATA="$(cat <<'__HO_EOF__'
### __HOSTS_DATA__ ###
__HO_EOF__
)"

# Network printers, one per line:  name<TAB>host
PRINTERS_DATA="$(cat <<'__PR_EOF__'
### __PRINTERS_DATA__ ###
__PR_EOF__
)"

# Static IP / DNS (reported as a manual note), one per line:  iface<TAB>ip<TAB>gw<TAB>dns
NETCFG_DATA="$(cat <<'__NE_EOF__'
### __NETCFG_DATA__ ###
__NE_EOF__
)"

# macOS has exactly one desktop environment (Aqua / Finder+Dock), so unlike the Linux
# edition there is nothing to detect -- but the variable is kept so the reporting and
# the generated stage scripts read the same on both platforms.
DE="aqua"
detect_de() { DE="aqua"; }

# Record a successfully-applied setting so it appears in the end-of-run summary.
# (The bare ok()/info()/log() helpers only print to the screen; they do NOT record,
# which is why applied settings would otherwise be missing from the summary.)
mark_set() { OK_LIST+=("$1"); record_line OK "$1" "${2:-}"; ok "applied: $1"; }

# -----------------------------------------------------------------------------
#  `defaults` helpers -- the macOS counterpart of gsettings on Linux.
#  dread/dset operate on the LOGGED-IN USER's preference domains; sysread/sysset
#  operate on system-wide plists (root). Both are idempotent: an unchanged value is
#  reported as "already set" instead of being written again.
# -----------------------------------------------------------------------------
dread() {  # dread DOMAIN KEY  -> current value on stdout (empty when unset)
  run_as_user defaults read "$1" "$2" 2>/dev/null
}

dset() {  # dset DOMAIN KEY TYPE VALUE   (TYPE = -bool | -int | -float | -string)
  local dom="$1" key="$2" type="$3" val="$4" cur want
  cur="$(dread "$dom" "$key")"
  # Normalise the two spellings `defaults` uses for booleans so "1" == "true".
  want="$val"
  case "$type" in
    -bool) case "$val" in [Tt]rue|1|yes|YES) want=1 ;; *) want=0 ;; esac
           case "$cur"  in [Tt]rue) cur=1 ;; [Ff]alse) cur=0 ;; esac ;;
  esac
  if [ -n "$cur" ] && [ "$cur" = "$want" ]; then
    mark_skip "$dom $key" "already set ($val)"; return 0
  fi
  if capture run_as_user defaults write "$dom" "$key" "$type" "$val"; then
    mark_set "$dom $key = $val"
  else
    mark_fail "config: $dom $key" "${LAST_ERR:-could not write the preference}"
  fi
}

dset_host() {  # dset_host DOMAIN KEY TYPE VALUE   (per-host domain: -currentHost)
  local dom="$1" key="$2" type="$3" val="$4" cur
  cur="$(run_as_user defaults -currentHost read "$dom" "$key" 2>/dev/null)"
  if [ -n "$cur" ] && [ "$cur" = "$val" ]; then mark_skip "$dom $key" "already set ($val)"; return 0; fi
  if capture run_as_user defaults -currentHost write "$dom" "$key" "$type" "$val"; then
    mark_set "$dom $key = $val"
  else
    mark_fail "config: $dom $key" "${LAST_ERR:-could not write the per-host preference}"
  fi
}

ddelete() {  # ddelete DOMAIN KEY  (idempotent: missing key is not an error)
  local dom="$1" key="$2"
  [ -z "$(dread "$dom" "$key")" ] && { mark_skip "$dom $key" "already unset"; return 0; }
  if capture run_as_user defaults delete "$dom" "$key"; then mark_set "$dom $key (cleared)"
  else mark_fail "config: $dom $key" "${LAST_ERR:-could not clear the preference}"; fi
}

sysset() {  # sysset PLIST_PATH KEY TYPE VALUE   (system-wide, runs as root)
  local plist="$1" key="$2" type="$3" val="$4" cur
  cur="$(defaults read "$plist" "$key" 2>/dev/null)"
  case "$type" in -bool) case "$cur" in [Tt]rue) cur=1 ;; [Ff]alse) cur=0 ;; esac ;; esac
  if [ -n "$cur" ] && [ "$cur" = "$val" ]; then mark_skip "$(basename "$plist") $key" "already set ($val)"; return 0; fi
  if capture defaults write "$plist" "$key" "$type" "$val"; then mark_set "$(basename "$plist") $key = $val"
  else mark_fail "config: $(basename "$plist") $key" "${LAST_ERR:-could not write the system preference}"; fi
}

# The primary network service name (e.g. "Wi-Fi", "Ethernet") -- needed by every
# `networksetup` call that configures proxies / DNS / static addressing.
primary_net_service() {
  networksetup -listnetworkserviceorder 2>/dev/null \
    | awk -F') ' '/^\([0-9]+\)/{print $2; exit}'
}

# The Wi-Fi hardware device (en0 / en1 ...).
wifi_device() {
  networksetup -listallhardwareports 2>/dev/null \
    | awk '/Hardware Port: Wi-Fi|Hardware Port: AirPort/{getline; print $2; exit}'
}

apply_display_scaling() {
  [ -z "${CFG_scaling:-}" ] && return 0
  log "Display scaling: ${CFG_scaling}"
  # macOS has no text-scaling factor: the display is scaled as a whole by picking a
  # HiDPI "looks like" resolution, which is a per-display choice with no supported CLI.
  # The closest honest action is to point the user at the exact place to set it.
  mark_manual "display scaling" "Windows used ${CFG_scaling}. On macOS set it in System Settings > Displays: pick a 'Larger Text' / 'More Space' scaled resolution (macOS scales the whole UI, it has no separate text-scaling factor)."
}

apply_lock_timeout() {
  [ -z "${CFG_lock_timeout:-}" ] && return 0
  local mins secs; mins="$(printf '%s' "$CFG_lock_timeout" | tr -cd '0-9')"
  log "Screen lock timeout: ${CFG_lock_timeout}"
  case "$(printf '%s' "$CFG_lock_timeout" | tr '[:upper:]' '[:lower:]')" in
    *never*) secs=0 ;;
    *) secs=$(( ${mins:-10} * 60 )) ;;
  esac
  # 1) when the screen saver / display sleep starts.
  dset_host com.apple.screensaver idleTime -int "$secs"
  # 2) how long after that the Mac actually locks. sysadminctl (10.15+) is the
  #    supported way; "off" disables the password requirement entirely.
  if have_cmd sysadminctl; then
    if [ "$secs" -eq 0 ]; then
      capture sysadminctl -screenLock off -password - && mark_set "screen lock disabled (Windows: never)" \
        || mark_fail "screen lock" "${LAST_ERR:-sysadminctl -screenLock off failed}"
    else
      # macOS accepts an immediate lock ("0") or a delay in seconds, max 8 hours.
      capture sysadminctl -screenLock 0 -password - && mark_set "lock immediately after the screen saver starts (${secs}s idle)" \
        || mark_fail "screen lock" "${LAST_ERR:-sysadminctl -screenLock failed}"
    fi
  else
    mark_manual "screen lock" "set 'Require password after screen saver begins' in System Settings > Lock Screen (Windows used ${CFG_lock_timeout})"
  fi
}

apply_keyboard_layout() {
  # Skip the whole module only when nothing keyboard-related was captured.
  [ -z "${CFG_keyboard_layout:-}${CFG_key_repeat_delay:-}${CFG_key_repeat_rate:-}${CFG_numlock:-}" ] && return 0
  log "Keyboard settings"
  if [ -n "${CFG_keyboard_layout:-}" ]; then
    # Map the free-text Windows layout onto macOS input sources (best-effort).
    local want_fa=0
    printf '%s' "$CFG_keyboard_layout" | grep -qi 'fa\|persian\|farsi' && want_fa=1
    local cur; cur="$(dread com.apple.HIToolbox AppleEnabledInputSources)"
    if [ "$want_fa" = "1" ] && printf '%s' "$cur" | grep -qi 'persian'; then
      mark_skip "keyboard input sources" "already includes Persian"
    elif [ "$want_fa" = "1" ]; then
      if capture run_as_user defaults write com.apple.HIToolbox AppleEnabledInputSources -array \
            '{ InputSourceKind = "Keyboard Layout"; "KeyboardLayout ID" = 0;    "KeyboardLayout Name" = "U.S."; }' \
            '{ InputSourceKind = "Keyboard Layout"; "KeyboardLayout ID" = 1600; "KeyboardLayout Name" = "Persian"; }'; then
        mark_set "keyboard input sources = U.S. + Persian (log out and back in to take effect)"
      else
        mark_manual "keyboard layout" "add the Persian input source in System Settings > Keyboard > Input Sources"
      fi
    else
      mark_skip "keyboard layout" "U.S. layout is the macOS default"
    fi
  fi
  # Key-repeat speed. Windows reports milliseconds; macOS counts 15 ms ticks and a
  # LOWER number is FASTER, so convert and clamp to the values the UI can produce.
  if [ -n "${CFG_key_repeat_delay:-}" ]; then
    local d; d="$(awk -v ms="$(printf '%s' "$CFG_key_repeat_delay" | tr -cd '0-9')" 'BEGIN{v=int((ms+7)/15); if(v<10)v=10; if(v>120)v=120; print v}')"
    dset NSGlobalDomain InitialKeyRepeat -int "$d"
  fi
  if [ -n "${CFG_key_repeat_rate:-}" ]; then
    local r; r="$(awk -v ms="$(printf '%s' "$CFG_key_repeat_rate" | tr -cd '0-9')" 'BEGIN{v=int((ms+7)/15); if(v<1)v=1; if(v>120)v=120; print v}')"
    dset NSGlobalDomain KeyRepeat -int "$r"
  fi
  # Mac keyboards have no Num Lock and macOS has no equivalent state to restore.
  [ -n "${CFG_numlock:-}" ] && log_note "numlock" "Mac keyboards have no Num Lock key - nothing to apply"
}

disable_telemetry_location() {
  [ -z "${CFG_location:-}${CFG_telemetry:-}" ] && return 0
  log "Privacy & security"
  # Crash/usage reports sent to Apple.
  sysset /Library/Application\ Support/CrashReporter/DiagnosticMessagesHistory.plist AutoSubmit -bool 0
  sysset /Library/Application\ Support/CrashReporter/DiagnosticMessagesHistory.plist ThirdPartyDataSubmit -bool 0
  dset com.apple.assistant.support "Siri Data Sharing Opt-In Status" -int 2
  dset com.apple.AdLib allowApplePersonalizedAdvertising -bool false
  # Location Services. System Integrity Protection guards locationd's preferences on
  # recent macOS releases, so this is genuinely best-effort -- report, never fail.
  if [ -n "${CFG_location:-}" ]; then
    local lplist=/var/db/locationd/Library/Preferences/ByHost/com.apple.locationd
    if defaults write "$lplist" LocationServicesEnabled -int 0 2>/dev/null; then
      launchctl kickstart -k system/com.apple.locationd >/dev/null 2>&1 || true
      mark_set "location services disabled"
    else
      mark_manual "location services" "System Integrity Protection blocks changing this from the command line - turn it off in System Settings > Privacy & Security > Location Services"
    fi
  fi
}

apply_lid_behavior() {
  log "Power: laptop lid behavior"
  if ! have_cmd pmset; then mark_skip "lid behavior" "pmset not available"; return 0; fi
  # Closing the lid always sleeps a Mac (there is no 'do nothing' option), so the
  # Windows setting is already the macOS behaviour. Make sure opening it wakes.
  local cur; cur="$(pmset -g custom 2>/dev/null | awk '/lidwake/{print $2; exit}')"
  if [ "$cur" = "1" ]; then
    mark_skip "lid behavior" "already configured (closing the lid sleeps, opening it wakes)"
  elif capture pmset -a lidwake 1; then
    mark_set "lid -> sleep on close, wake on open"
  else
    mark_fail "lid behavior" "${LAST_ERR:-pmset -a lidwake failed}"
  fi
}

apply_resolution() {
  [ -z "${CFG_resolution:-}" ] && return 0
  case "$CFG_resolution" in *[0-9]x[0-9]*) ;; *) return 0 ;; esac
  log "Display resolution: ${CFG_resolution}"
  # macOS ships no resolution CLI; displayplacer is the community standard.
  if ! have_cmd displayplacer; then
    ask_install_addition "display resolution" "displayplacer" "set the screen resolution from the command line" \
      || { mark_manual "display resolution" "set ${CFG_resolution} in System Settings > Displays"; return 0; }
  fi
  have_cmd displayplacer || { mark_manual "display resolution" "set ${CFG_resolution} in System Settings > Displays"; return 0; }
  local pid cur
  pid="$(run_as_user displayplacer list 2>/dev/null | awk -F': ' '/Persistent screen id/{print $2; exit}')"
  cur="$(run_as_user displayplacer list 2>/dev/null | awk -F'res:' '/current mode/{split($2,a," "); print a[1]; exit}')"
  [ -z "$pid" ] && { mark_manual "display resolution" "displayplacer found no display to configure"; return 0; }
  [ "$cur" = "$CFG_resolution" ] && { mark_skip "display resolution" "already $CFG_resolution"; return 0; }
  if capture run_as_user displayplacer "id:${pid} res:${CFG_resolution}"; then
    mark_set "resolution $pid = $CFG_resolution"
  else
    mark_fail "display resolution" "${LAST_ERR:-displayplacer could not set ${CFG_resolution} (the mode may be unsupported on this display)}"
  fi
}

apply_mouse() {
  [ -z "${CFG_mouse_size:-}${CFG_mouse_speed:-}${CFG_mouse_accel:-}${CFG_mouse_swap:-}${CFG_mouse_dblclick:-}" ] && return 0
  log "Mouse: pointer size / speed / acceleration / buttons"
  # Pointer size on macOS is a multiplier (1.0 = normal .. 4.0 = largest).
  if [ -n "${CFG_mouse_size:-}" ]; then
    local sz; sz="$(awk -v v="$(printf '%s' "$CFG_mouse_size" | tr -cd '0-9')" 'BEGIN{ if(v=="")v=32; s=v/32; if(s<1)s=1; if(s>4)s=4; printf "%.1f", s }')"
    dset com.apple.universalaccess mouseDriverCursorSize -float "$sz"
  fi
  [ -n "${CFG_mouse_speed:-}" ] && dset NSGlobalDomain com.apple.mouse.scaling -float "$CFG_mouse_speed"
  # "flat" (no acceleration) maps to the special scaling value -1 on macOS.
  case "${CFG_mouse_accel:-}" in
    flat|off|false|0) dset NSGlobalDomain com.apple.mouse.scaling -float -1 ;;
  esac
  if [ -n "${CFG_mouse_swap:-}" ]; then
    case "$CFG_mouse_swap" in
      true|1|yes) dset NSGlobalDomain com.apple.mouse.swapLeftRightButton -bool true ;;
      *)          dset NSGlobalDomain com.apple.mouse.swapLeftRightButton -bool false ;;
    esac
  fi
  # Windows reports the double-click interval in ms; macOS wants seconds.
  if [ -n "${CFG_mouse_dblclick:-}" ]; then
    local dc; dc="$(awk -v ms="$(printf '%s' "$CFG_mouse_dblclick" | tr -cd '0-9')" 'BEGIN{ if(ms=="")ms=500; printf "%.2f", ms/1000 }')"
    dset NSGlobalDomain com.apple.mouse.doubleClickThreshold -float "$dc"
  fi
}

apply_appearance() {
  [ -z "${CFG_color_scheme:-}${CFG_accent:-}${CFG_night_light:-}" ] && return 0
  log "Appearance: theme / accent / night shift"
  case "${CFG_color_scheme:-}" in
    prefer-dark|dark|Dark) dset NSGlobalDomain AppleInterfaceStyle -string Dark ;;
    prefer-light|light|default|Light) ddelete NSGlobalDomain AppleInterfaceStyle ;;
  esac
  # macOS accent colours are an enum: 0 red, 1 orange, 2 yellow, 3 green, 4 blue,
  # 5 purple, 6 pink, -1 graphite. Map the nearest name Windows gave us.
  if [ -n "${CFG_accent:-}" ]; then
    local acc=""
    case "$(printf '%s' "$CFG_accent" | tr '[:upper:]' '[:lower:]')" in
      *red*)              acc=0 ;;
      *orange*)           acc=1 ;;
      *yellow*|*gold*)    acc=2 ;;
      *green*|*teal*)     acc=3 ;;
      *blue*|*cyan*)      acc=4 ;;
      *purple*|*violet*)  acc=5 ;;
      *pink*|*magenta*)   acc=6 ;;
      *gray*|*grey*|*graphite*) acc=-1 ;;
    esac
    if [ -n "$acc" ]; then
      dset NSGlobalDomain AppleAccentColor -int "$acc"
    else
      mark_manual "accent colour" "Windows accent '${CFG_accent}' has no direct macOS equivalent - pick one in System Settings > Appearance"
    fi
  fi
  # Night Shift has no supported CLI; the `nightlight` helper is the usual answer.
  if [ -n "${CFG_night_light:-}" ]; then
    case "$CFG_night_light" in
      true|1|yes|on)
        if have_cmd nightlight || ask_install_addition "night shift" "nightlight" "turn Night Shift on from the command line"; then
          if capture run_as_user nightlight on; then mark_set "Night Shift enabled"
          else mark_manual "night shift" "turn it on in System Settings > Displays > Night Shift"; fi
        else
          mark_manual "night shift" "turn it on in System Settings > Displays > Night Shift"
        fi ;;
      *) mark_skip "night shift" "was off on Windows" ;;
    esac
  fi
}

apply_touchpad() {
  [ -z "${CFG_touchpad_tap:-}${CFG_touchpad_natural:-}" ] && return 0
  log "Trackpad: tap-to-click / natural scroll"
  if [ -n "${CFG_touchpad_tap:-}" ]; then
    local tap=false ti=0
    case "$CFG_touchpad_tap" in true|1|yes) tap=true; ti=1 ;; esac
    dset com.apple.AppleMultitouchTrackpad Clicking -bool "$tap"
    dset com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool "$tap"
    dset_host NSGlobalDomain com.apple.mouse.tapBehavior -int "$ti"
  fi
  if [ -n "${CFG_touchpad_natural:-}" ]; then
    case "$CFG_touchpad_natural" in
      true|1|yes) dset NSGlobalDomain com.apple.swipescrolldirection -bool true ;;
      *)          dset NSGlobalDomain com.apple.swipescrolldirection -bool false ;;
    esac
  fi
}

apply_power_timeouts() {
  [ -z "${CFG_sleep_ac:-}${CFG_sleep_dc:-}" ] && return 0
  log "Power: sleep timeouts"
  have_cmd pmset || { mark_manual "power timeouts" "set the sleep timers in System Settings > Battery / Energy Saver"; return 0; }
  # Windows exports seconds; pmset wants whole minutes (0 = never).
  local acm dcm
  if [ -n "${CFG_sleep_ac:-}" ]; then
    acm="$(awk -v s="$(printf '%s' "$CFG_sleep_ac" | tr -cd '0-9')" 'BEGIN{ if(s=="")s=0; printf "%d", (s+59)/60 }')"
    if capture pmset -c sleep "$acm"; then mark_set "sleep on power adapter = ${acm} min"
    else mark_fail "sleep (AC)" "${LAST_ERR:-pmset -c sleep failed}"; fi
  fi
  if [ -n "${CFG_sleep_dc:-}" ]; then
    dcm="$(awk -v s="$(printf '%s' "$CFG_sleep_dc" | tr -cd '0-9')" 'BEGIN{ if(s=="")s=0; printf "%d", (s+59)/60 }')"
    if capture pmset -b sleep "$dcm"; then mark_set "sleep on battery = ${dcm} min"
    else mark_fail "sleep (battery)" "${LAST_ERR:-pmset -b sleep failed}"; fi
  fi
}

apply_locale() {
  [ -z "${CFG_locale:-}" ] && return 0
  log "Locale: ${CFG_locale}"
  # Windows gives e.g. en_US.UTF-8; macOS stores AppleLocale as en_US and the
  # language list as BCP-47 tags (en-US).
  local loc lang
  loc="$(printf '%s' "$CFG_locale" | sed 's/\..*$//; s/-/_/')"
  lang="$(printf '%s' "$loc" | tr '_' '-')"
  dset NSGlobalDomain AppleLocale -string "$loc"
  local cur; cur="$(dread NSGlobalDomain AppleLanguages | tr -d ' \n"()' )"
  case "$cur" in
    *"$lang"*) mark_skip "NSGlobalDomain AppleLanguages" "already starts with $lang" ;;
    *) if capture run_as_user defaults write NSGlobalDomain AppleLanguages -array "$lang"; then
         mark_set "system language = $lang (log out and back in to take effect)"
       else mark_fail "locale" "${LAST_ERR:-could not set AppleLanguages}"; fi ;;
  esac
}

apply_proxy() {
  case "${CFG_proxy_mode:-}" in
    '') return 0 ;;
  esac
  log "Proxy: ${CFG_proxy_mode}"
  local svc; svc="$(primary_net_service)"
  [ -z "$svc" ] && { mark_manual "proxy" "no active network service found; set the proxy in System Settings > Network > Details > Proxies"; return 0; }
  case "$CFG_proxy_mode" in
    none)
      capture networksetup -setwebproxystate      "$svc" off >/dev/null 2>&1 || true
      capture networksetup -setsecurewebproxystate "$svc" off >/dev/null 2>&1 || true
      capture networksetup -setautoproxystate      "$svc" off >/dev/null 2>&1 || true
      mark_set "proxy disabled on '$svc'" ;;
    manual)
      if [ -n "${CFG_proxy_host:-}" ] && [ -n "${CFG_proxy_port:-}" ]; then
        local okc=0
        capture networksetup -setwebproxy       "$svc" "$CFG_proxy_host" "$CFG_proxy_port" && okc=1
        capture networksetup -setsecurewebproxy "$svc" "$CFG_proxy_host" "$CFG_proxy_port" && okc=1
        capture networksetup -setwebproxystate       "$svc" on >/dev/null 2>&1 || true
        capture networksetup -setsecurewebproxystate "$svc" on >/dev/null 2>&1 || true
        if [ "$okc" = "1" ]; then mark_set "proxy on '$svc' = ${CFG_proxy_host}:${CFG_proxy_port} (HTTP + HTTPS)"
        else mark_fail "proxy" "${LAST_ERR:-networksetup could not set the proxy}"; fi
      else
        mark_manual "proxy" "manual proxy mode with no host/port captured"
      fi ;;
    auto)
      if [ -n "${CFG_proxy_autoconfig:-}" ]; then
        if capture networksetup -setautoproxyurl "$svc" "$CFG_proxy_autoconfig"; then
          mark_set "auto-proxy (PAC) on '$svc' = $CFG_proxy_autoconfig"
        else mark_fail "proxy" "${LAST_ERR:-networksetup could not set the PAC URL}"; fi
      else
        capture networksetup -setproxyautodiscovery "$svc" on >/dev/null 2>&1 \
          && mark_set "proxy auto-discovery (WPAD) enabled on '$svc'" \
          || mark_manual "proxy" "enable automatic proxy discovery in System Settings > Network > Details > Proxies"
      fi ;;
  esac
  # Also export to the shell profile for CLI tools (manual mode only) -- macOS has no
  # /etc/environment, so the login shell's profile is the equivalent place.
  if [ "$CFG_proxy_mode" = "manual" ] && [ -n "${CFG_proxy_host:-}" ] && [ -n "${CFG_proxy_port:-}" ]; then
    local url="http://${CFG_proxy_host}:${CFG_proxy_port}" prof="$TARGET_HOME/.zprofile"
    if [ -f "$prof" ] && grep -qF "$url" "$prof" 2>/dev/null; then
      mark_skip "proxy env" "already in $prof"
    else
      { printf '\n# migrated from Windows by the Migration Toolkit\n'
        printf 'export http_proxy=%s\nexport https_proxy=%s\nexport HTTP_PROXY=%s\nexport HTTPS_PROXY=%s\n' "$url" "$url" "$url" "$url"
      } >> "$prof" 2>/dev/null \
        && { own "$prof"; mark_set "proxy env -> $prof ($url)"; } \
        || mark_fail "proxy env" "could not write $prof"
    fi
  fi
}

apply_hosts() {
  [ -z "$(printf '%s' "$HOSTS_DATA" | tr -d '[:space:]')" ] && return 0
  log "Hosts file: custom entries -> /etc/hosts"
  local line added=0
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    if grep -qF "$line" /etc/hosts 2>/dev/null; then mark_skip "hosts: $line" "already present"; continue; fi
    if printf '%s\n' "$line" >> /etc/hosts 2>/dev/null; then mark_set "hosts: $line"; added=$((added+1))
    else mark_fail "hosts: $line" "could not append to /etc/hosts"; fi
  done <<EOF
$(printf '%s\n' "$HOSTS_DATA")
EOF
  # macOS caches DNS aggressively; flush so the new entries take effect immediately.
  if [ "$added" -gt 0 ]; then
    dscacheutil -flushcache 2>/dev/null || true
    killall -HUP mDNSResponder 2>/dev/null || true
    info "added $added custom hosts entr(ies) (DNS cache flushed)"
  fi
}

apply_printers() {
  [ -z "$(printf '%s' "$PRINTERS_DATA" | tr -d '[:space:]')" ] && return 0
  log "Network printers -> CUPS (macOS printing)"
  # CUPS is part of macOS, so lpadmin is always present -- no package to install.
  have_cmd lpadmin || { mark_manual "printers" "lpadmin is missing; add the printers in System Settings > Printers & Scanners"; return 0; }
  local name host uri
  while IFS="$(printf '\t')" read -r name host; do
    [ -z "$name" ] && continue
    if lpstat -p "$name" >/dev/null 2>&1; then mark_skip "printer: $name" "already configured"; continue; fi
    case "$host" in http://*|https://*|ipp://*|ipps://*|smb://*) uri="$host" ;; *) uri="ipp://${host}/ipp/print" ;; esac
    if capture lpadmin -p "$(printf '%s' "$name" | tr ' ' '_')" -E -v "$uri" -m everywhere; then
      mark_set "printer: $name -> $uri"
    else mark_manual "printer: $name" "add it manually in System Settings > Printers & Scanners (tried $uri)"; fi
  done <<EOF
$(printf '%s\n' "$PRINTERS_DATA")
EOF
}

apply_netcfg() {
  [ -z "$(printf '%s' "$NETCFG_DATA" | tr -d '[:space:]')" ] && return 0
  # Deploying the static network config is optional: it was staged on Windows,
  # but ask before applying it here so the user can opt out.
  if [ -r /dev/tty ]; then
    warn "Static network configuration was exported from Windows. Do you want to apply it on this Mac now? (y/n)"
    local dans; printf '  (y/n): ' > /dev/tty; read -r dans < /dev/tty || dans="n"
    case "$dans" in [Yy]*) ;; *) mark_skip "network config" "deployment skipped by user"; return 0 ;; esac
  else
    mark_skip "network config" "deployment is optional; no terminal available to confirm"; return 0
  fi
  log "Static IP / DNS (reported, not auto-applied, so networking can't break)"
  local iface ip gw dns svc
  svc="$(primary_net_service)"
  while IFS="$(printf '\t')" read -r iface ip gw dns; do
    [ -z "$iface$ip$dns" ] && continue
    mark_manual "network: $iface" "apply on '${svc:-your network service}' if wanted:  sudo networksetup -setmanual '${svc:-Wi-Fi}' ${ip:-<ip>} 255.255.255.0 ${gw:-<gateway>}  and  sudo networksetup -setdnsservers '${svc:-Wi-Fi}' ${dns:-<dns>}"
  done <<EOF
$(printf '%s\n' "$NETCFG_DATA")
EOF
}

apply_accessibility() {
  [ -z "${CFG_a11y_stickykeys:-}${CFG_a11y_slowkeys:-}${CFG_a11y_bouncekeys:-}${CFG_a11y_mousekeys:-}${CFG_a11y_highcontrast:-}${CFG_a11y_magnifier:-}${CFG_a11y_screenreader:-}" ] && return 0
  log "Accessibility options"
  [ -n "${CFG_a11y_stickykeys:-}" ] && dset com.apple.universalaccess stickyKey -bool "$CFG_a11y_stickykeys"
  [ -n "${CFG_a11y_slowkeys:-}" ]   && dset com.apple.universalaccess slowKey   -bool "$CFG_a11y_slowkeys"
  [ -n "${CFG_a11y_mousekeys:-}" ]  && dset com.apple.universalaccess mouseDriver -bool "$CFG_a11y_mousekeys"
  [ -n "${CFG_a11y_highcontrast:-}" ] && dset com.apple.universalaccess increaseContrast -bool "$CFG_a11y_highcontrast"
  [ -n "${CFG_a11y_magnifier:-}" ]  && dset com.apple.universalaccess closeViewScrollWheelToggle -bool "$CFG_a11y_magnifier"
  # macOS has no Bounce Keys (Slow Keys covers the same need) and VoiceOver cannot be
  # switched on from the command line -- report both instead of silently doing nothing.
  case "${CFG_a11y_bouncekeys:-}" in
    true|1|yes) mark_manual "bounce keys" "macOS has no Bounce Keys; the closest option is Slow Keys in System Settings > Accessibility > Keyboard" ;;
  esac
  case "${CFG_a11y_screenreader:-}" in
    true|1|yes) mark_manual "screen reader" "turn VoiceOver on with Command+F5, or in System Settings > Accessibility > VoiceOver" ;;
  esac
}

apply_timezone_timesync() {
  [ -z "${CFG_timezone:-}${CFG_ntp_server:-}" ] && return 0
  log "Timezone & time synchronization"
  if [ -n "${CFG_timezone:-}" ] && [ "$CFG_timezone" != "unknown" ] && have_cmd systemsetup; then
    local curtz; curtz="$(systemsetup -gettimezone 2>/dev/null | sed 's/^Time Zone: //')"
    if [ "$curtz" = "$CFG_timezone" ]; then mark_skip "timezone" "already $CFG_timezone"
    elif systemsetup -listtimezones 2>/dev/null | grep -qx "[[:space:]]*$CFG_timezone"; then
      if capture systemsetup -settimezone "$CFG_timezone"; then mark_set "timezone = $CFG_timezone"
      else mark_fail "timezone" "${LAST_ERR:-systemsetup -settimezone failed for $CFG_timezone}"; fi
    elif capture systemsetup -settimezone "$CFG_timezone"; then
      mark_set "timezone = $CFG_timezone"
    else
      mark_fail "timezone" "${LAST_ERR:-macOS does not know the timezone '$CFG_timezone'}"
    fi
  fi
  # Time synchronization with a non-Microsoft NTP server.
  local ntp="${CFG_ntp_server:-}"
  case "$ntp" in *time.windows.com*|"") ntp="time.apple.com" ;; esac
  if have_cmd systemsetup; then
    local curntp; curntp="$(systemsetup -getnetworktimeserver 2>/dev/null | sed 's/^Network Time Server: //')"
    if [ "$curntp" = "$ntp" ]; then
      mark_skip "ntp server" "already $ntp"
    elif capture systemsetup -setnetworktimeserver "$ntp"; then
      systemsetup -setusingnetworktime on >/dev/null 2>&1 || true
      mark_set "ntp server = $ntp (network time enabled)"
    else
      mark_fail "ntp server" "${LAST_ERR:-systemsetup -setnetworktimeserver failed}"
    fi
  else
    mark_manual "ntp server" "set the time server to $ntp in System Settings > General > Date & Time"
  fi
}

apply_wifi() {
  [ -z "$(printf '%s' "$WIFI_DATA" | tr -d '[:space:]')" ] && return 0
  log "WiFi known networks"
  local dev; dev="$(wifi_device)"
  if [ -z "$dev" ]; then
    mark_manual "wifi networks" "no Wi-Fi hardware port found on this Mac; import the networks manually"; return 0
  fi
  info "Wi-Fi device: $dev"
  # If any entry carries an encrypted key, a transfer password WAS provided on
  # Windows: ask once to decrypt the keys.
  local has_enc=0 wifikey="" ob=""
  printf '%s\n' "$WIFI_DATA" | awk -F'\t' '$4=="enc"{f=1} END{exit !f}' && has_enc=1
  if [ "$has_enc" = "1" ]; then
    ob="$(openssl_bin 2>/dev/null)"
    [ -n "$ob" ] || ask_install_addition "wifi passwords" "openssl@3" "decrypt the exported WiFi passwords" || true
    ob="$(openssl_bin 2>/dev/null)"
    # The decryption password was collected once, up front (ask_xfer_password); reuse it.
    [ -n "$ob" ] && wifikey="$MIGRATE_XFER_PWD"
  else
    # No transfer password was provided on Windows (or it timed out): there may be
    # password-protected networks with no stored key. Ask whether to import them
    # anyway (manual password entry per network). "No" skips WiFi entirely.
    local has_prot=0
    printf '%s\n' "$WIFI_DATA" | awk -F'\t' '$1!="" && tolower($2)!="open" && tolower($2)!="none" && $4!="enc"{f=1} END{exit !f}' && has_prot=1
    if [ "$has_prot" = "1" ] && [ -r /dev/tty ]; then
      local YEL=$'\033[1;33m' RST=$'\033[0m' wans
      printf '\n  You %sdid not%s provide a %spassword%s for sensitive data encryption while exporting your data on Windows (or providing a %spassword%s was %stimed out%s).\n' "$YEL" "$RST" "$YEL" "$RST" "$YEL" "$RST" "$YEL" "$RST" >&3
      printf '  Do you still want to transfer WiFi networks without their passwords?\n' >&3
      printf '  (if "yes", manual password entry for each password-protected one is required)\n' >&3
      printf '  If you %sdid not%s intend for this, you can go over to Windows and export your data again with providing the encryption pass this time. (y/n)\n' "$YEL" "$RST" >&3
      printf '  (y/n): ' > /dev/tty; read -r wans < /dev/tty || wans="y"
      case "$wans" in [Nn]*) mark_skip "wifi networks" "skipped (no transfer password provided on Windows)"; return 0 ;; esac
    fi
  fi
  local ssid auth secret sectype psk exists known sec
  known="$(networksetup -listpreferredwirelessnetworks "$dev" 2>/dev/null)"
  while IFS="$(printf '\t')" read -r ssid auth secret sectype; do
    [ -z "$ssid" ] && continue
    # Is this SSID already in the preferred-networks list? Networks WITH a password
    # are re-added (which refreshes the stored key); others are left as-is / skipped.
    exists=0
    printf '%s\n' "$known" | sed 's/^[[:space:]]*//' | grep -qxF "$ssid" && exists=1
    # Map the Windows authentication string onto a macOS security type.
    case "$(printf '%s' "$auth" | tr '[:upper:]' '[:lower:]')" in
      open|none|"")     sec="OPEN" ;;
      *wpa3*)           sec="WPA3" ;;
      *wpa2*|*rsna*)    sec="WPA2" ;;
      *wpa*)            sec="WPA" ;;
      *wep*)            sec="WEP" ;;
      *)                sec="WPA2" ;;
    esac
    # Open networks have no key: add them straight away (no password needed).
    if [ "$sec" = "OPEN" ]; then
      if [ "$exists" = "1" ]; then mark_skip "wifi: $ssid" "network already known"; continue; fi
      if capture networksetup -addpreferredwirelessnetworkatindex "$dev" "$ssid" 0 OPEN; then
        mark_set "wifi: $ssid (open network)"
      else mark_fail "wifi: $ssid" "${LAST_ERR:-networksetup could not add the network}"; fi
      continue
    fi
    psk=""
    case "$sectype" in
      enc) if [ -n "$wifikey" ] && [ -n "$ob" ]; then
             psk="$(printf '%s' "$secret" | "$ob" enc -d -aes-256-cbc -pbkdf2 -salt -base64 -A -pass pass:"$wifikey" 2>/dev/null)" || psk=""
           fi ;;
      plain) psk="$secret" ;;
    esac
    if [ -n "$psk" ]; then
      # Re-adding an existing SSID updates its stored password, so this covers both cases.
      [ "$exists" = "1" ] && networksetup -removepreferredwirelessnetwork "$dev" "$ssid" >/dev/null 2>&1
      if capture networksetup -addpreferredwirelessnetworkatindex "$dev" "$ssid" 0 "$sec" "$psk"; then
        # Also store the key in the system keychain so it auto-joins without prompting.
        security add-generic-password -U -a "$ssid" -s "AirPort" -D "AirPort network password" \
          -w "$psk" -T /System/Library/CoreServices/SystemUIServer.app \
          /Library/Keychains/System.keychain >/dev/null 2>&1 || true
        if [ "$exists" = "1" ]; then mark_set "wifi: $ssid (password updated)"
        else mark_set "wifi: $ssid (with saved password)"; fi
      else mark_fail "wifi: $ssid" "${LAST_ERR:-networksetup could not add the network}"; fi
    else
      if [ "$exists" = "1" ]; then mark_skip "wifi: $ssid" "network already known"; continue; fi
      if capture networksetup -addpreferredwirelessnetworkatindex "$dev" "$ssid" 0 "$sec"; then
        mark_manual "wifi: $ssid" "network added WITHOUT a password - enter the WiFi password when macOS asks to join"
      else mark_fail "wifi: $ssid" "${LAST_ERR:-networksetup could not add the network}"; fi
    fi
  done <<EOF
$(printf '%s\n' "$WIFI_DATA")
EOF
}

# --------------------------------------------------------------------------------------
# Windows -> macOS firewall mapping helpers.
#
# Windows exports each rule as:  name | direction | action | enabled | protocol |
# localPort | remotePort | program | service.  A few Windows port fields are service
# *keywords* rather than numbers; translate the well-known ones here -- this is the SINGLE
# place to add more.  Windows sometimes tags a keyword with a direction suffix (e.g.
# "IPHTTPSOut", "IPTLSIn"); the variants are listed explicitly so they resolve too.
# Anything still non-numeric afterwards is reported as un-migratable on screen.
fw_port_alias() {  # fw_port_alias VALUE -> numeric port/range, or VALUE unchanged
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    rpcepmap|rpc-epmap)                                  printf '135' ;;          # RPC Endpoint Mapper
    rpc)                                                 printf '49152-65535' ;;  # dynamic RPC range (Windows ephemeral range)
    iphttps|iphttpsin|iphttpsout|iptls|iptlsin|iptlsout) printf '443' ;;          # IP-HTTPS / IP-over-TLS tunnelling
    teredo|teredoin|teredoout)                           printf '3544' ;;         # Teredo IPv6 tunnelling
    mdns|mdnsin|mdnsout)                                 printf '5353' ;;         # multicast DNS (Bonjour on macOS)
    ply2disc|playtodiscovery|playto)                     printf '3702' ;;         # Play-To device discovery (WS-Discovery)
    wsd|wsdevents|wsdeventssecure)                        printf '5357' ;;         # Web Services on Devices (WSDAPI)
    ssdp|ssdpin|ssdpout)                                 printf '1900' ;;         # SSDP / UPnP discovery
    dhcp)                                                printf '68' ;;           # DHCP client
    dns)                                                 printf '53' ;;           # DNS
    llmnr)                                               printf '5355' ;;         # Link-Local Multicast Name Resolution
    *)                                                   printf '%s' "$1" ;;
  esac
}

# --------------------------------------------------------------------------------------
# macOS firewalling has TWO independent layers, and the Windows rules map cleanly onto
# both -- which is why nothing is lost in this migration:
#
#   1. The Application Firewall (socketfilterfw) is PROGRAM-scoped: it allows or blocks
#      incoming connections per application. That is the exact shape of a Windows rule
#      that is scoped to a program and opens "any port", so those rules -- which on Linux
#      needed OpenSnitch -- are native here.
#   2. pf (the packet filter, /etc/pf.anchors) handles PORT-scoped rules. We collect
#      every port rule into one anchor file and load it in a single pass at the end, so
#      the ruleset is atomic and easy to review or remove.
# --------------------------------------------------------------------------------------
SOCKETFW="/usr/libexec/ApplicationFirewall/socketfilterfw"
PF_ANCHOR_NAME="migrate_to_macos"
PF_ANCHOR_FILE="/etc/pf.anchors/${PF_ANCHOR_NAME}"
PF_RULES_TMP=""

# Return the bare exe name for a REAL application program path, or empty for "no program"
# and for Windows system pseudo-programs that have no macOS counterpart (svchost, System,
# core service hosts). Empty -> caller falls back to the manual-review message.
fw_program_exe() {  # fw_program_exe WINDOWS_PROGRAM_PATH -> exe basename or empty
  local p="$1" base
  case "$p" in ""|[Aa]ny|[Ss]ystem) return 0 ;; esac
  base="${p##*\\}"; base="${base##*/}"          # strip Windows (or Unix) directory
  case "$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')" in
    ""|svchost.exe|services.exe|lsass.exe|system|spoolsv.exe|taskhostw.exe) return 0 ;;
  esac
  printf '%s' "$base"
}

# Map a Windows exe base name onto an installed macOS application bundle, so a
# program-scoped rule can be recreated against the real app. Echoes the .app path.
fw_resolve_app() {  # fw_resolve_app EXEBASE -> /Applications/Something.app  (or empty)
  local exe="${1%.exe}" d app low
  [ -n "$exe" ] || return 1
  low="$(printf '%s' "$exe" | tr '[:upper:]' '[:lower:]')"
  for d in "$APPS_DIR" "$(user_apps_dir)"; do
    [ -d "$d" ] || continue
    for app in "$d"/*.app; do
      [ -d "$app" ] || continue
      case "$(basename "$app" .app | tr '[:upper:]' '[:lower:]' | tr -d ' ')" in
        "$(printf '%s' "$low" | tr -d ' ')"*) printf '%s' "$app"; return 0 ;;
      esac
    done
  done
  return 1
}

# Make sure the Application Firewall is available and its state is known.
# Memoised in SOCKETFW_READY: 1=usable, 2=unavailable (do not retry per rule).
SOCKETFW_READY=0
ensure_socketfw() {
  case "$SOCKETFW_READY" in 1) return 0 ;; 2) return 1 ;; esac
  if [ -x "$SOCKETFW" ]; then SOCKETFW_READY=1; return 0; fi
  SOCKETFW_READY=2; return 1
}

# Add ONE program-scoped rule to the macOS Application Firewall.
socketfw_add_rule() {  # socketfw_add_rule APP_PATH ACTION
  local app="$1" act="$2"
  is_dry_run && { info "[dry-run] would $act incoming connections for $app"; return 0; }
  "$SOCKETFW" --add "$app" >/dev/null 2>&1 || true
  if [ "$act" = "Block" ]; then
    "$SOCKETFW" --blockapp "$app" >/dev/null 2>&1 || return 1
  else
    "$SOCKETFW" --unblockapp "$app" >/dev/null 2>&1 || return 1
  fi
  return 0
}

# Buffer ONE concrete (port-or-range, transport) rule as a pf rule line. pf ranges use
# "N:M". Every rule is "quick" so the anchor behaves first-match-wins (predictable and
# order-preserving relative to the Windows rule list). Returns 1 only on a write error.
fw_apply_one() {  # fw_apply_one PORT_OR_RANGE PROTO ACTION DIR
  local e="$1" pp="$2" act="$3" d="$4" verb dirw port
  port="$e"; case "$e" in *-*) port="${e%-*}:${e#*-}" ;; esac
  if [ "$act" = "Block" ]; then verb="block drop quick"; else verb="pass quick"; fi
  case "$d" in *out*) dirw="out" ;; *) dirw="in" ;; esac
  [ -n "$PF_RULES_TMP" ] || return 1
  printf '%s %s proto %s from any to any port %s\n' "$verb" "$dirw" "$pp" "$port" >> "$PF_RULES_TMP" 2>/dev/null || return 1
  return 0
}

# Write the collected pf rules into our own anchor, reference the anchor from
# /etc/pf.conf (once, idempotently) and reload pf. Everything this toolkit adds lives in
# ONE file, so it can be reviewed with `cat` and removed by deleting that file.
pf_install_anchor() {
  [ -s "$PF_RULES_TMP" ] || return 0
  if is_dry_run; then info "[dry-run] would install $(wc -l < "$PF_RULES_TMP" | tr -d ' ') pf rule(s) into $PF_ANCHOR_FILE"; return 0; fi
  mkdir -p /etc/pf.anchors 2>/dev/null || true
  {
    printf '# Firewall port rules migrated from Windows by the Migration Toolkit.\n'
    printf '# Loaded from /etc/pf.conf via the "%s" anchor. Delete this file and the two\n' "$PF_ANCHOR_NAME"
    printf '# anchor lines in /etc/pf.conf to remove every rule below.\n'
    cat "$PF_RULES_TMP"
  } > "$PF_ANCHOR_FILE" 2>/dev/null || { mark_fail "firewall port rules" "could not write $PF_ANCHOR_FILE"; return 1; }
  chmod 0644 "$PF_ANCHOR_FILE" 2>/dev/null || true
  if ! grep -q "anchor \"$PF_ANCHOR_NAME\"" /etc/pf.conf 2>/dev/null; then
    cp -n /etc/pf.conf /etc/pf.conf.migrate.bak 2>/dev/null || true
    {
      printf '\n# Added by the Windows->macOS Migration Toolkit\n'
      printf 'anchor "%s"\n' "$PF_ANCHOR_NAME"
      printf 'load anchor "%s" from "%s"\n' "$PF_ANCHOR_NAME" "$PF_ANCHOR_FILE"
    } >> /etc/pf.conf 2>/dev/null || { mark_fail "firewall port rules" "could not reference the anchor from /etc/pf.conf"; return 1; }
  fi
  # Validate before loading so a bad rule can never wedge the packet filter.
  if ! pfctl -n -f /etc/pf.conf >/dev/null 2>&1; then
    mark_fail "firewall port rules" "pf rejected the generated ruleset ($PF_ANCHOR_FILE); it was written but NOT loaded"
    return 1
  fi
  pfctl -f /etc/pf.conf >/dev/null 2>&1 || true
  return 0
}

apply_firewall() {
  [ -z "$(printf '%s' "$FIREWALL_DATA" | tr -d '[:space:]')" ] && return 0
  # Deploying the exported firewall rules is optional: the rules were staged on
  # Windows, but ask before applying them here so the user can opt out.
  if [ -r /dev/tty ]; then
    warn "Firewall rules were exported from Windows. Do you want to apply them on this Mac now?"
    warn "If you skip, no rules are created (you can re-run later to apply them). (y/n)"
    local dans; printf '  (y/n): ' > /dev/tty; read -r dans < /dev/tty || dans="n"
    case "$dans" in [Yy]*) ;; *) mark_skip "firewall rules" "deployment skipped by user"; return 0 ;; esac
  else
    mark_skip "firewall rules" "deployment is optional; no terminal available to confirm"; return 0
  fi
  log "Firewall rules (Application Firewall for program rules, pf for port rules)"
  PF_RULES_TMP="$(mktemp -t mtm_pf)"

  local name dir action enabled proto lport rport program service dirl port plow protos applied problem p e pp oldifs exe appath
  while IFS="$(printf '\t')" read -r name dir action enabled proto lport rport program service; do
    [ -z "$name" ] && continue
    proto="$(printf '%s' "$proto" | tr '[:upper:]' '[:lower:]')"
    dirl="$(printf '%s' "$dir" | tr '[:upper:]' '[:lower:]')"

    # Disabled-on-Windows rules are not migrated; record them in the log only.
    if [ "$enabled" != "True" ]; then record_line LOG "fw: $name" "disabled on Windows - not migrated"; continue; fi

    # Pick the port that actually matters for the direction: an INbound rule is about the
    # local listening port; an OUTbound rule is about the destination port it connects to
    # (its local port is just an ephemeral source). Fall back to the other if one is empty.
    case "$dirl" in
      *out*) port="$rport"; [ -z "$port" ] && port="$lport" ;;
      *)     port="$lport"; [ -z "$port" ] && port="$rport" ;;
    esac
    port="$(fw_port_alias "$port")"
    plow="$(printf '%s' "$port" | tr '[:upper:]' '[:lower:]')"

    # No concrete port -> a whole-protocol allow, too broad to recreate as a pf port rule.
    # If the Windows rule was scoped to a real program, recreate that scope natively with
    # the macOS Application Firewall (which is program-scoped by design). Otherwise (no
    # program, or a Windows system pseudo-program) report it for manual review.
    case "$plow" in
      ""|any|"*")
        exe="$(fw_program_exe "$program")"
        if [ -n "$exe" ] && ensure_socketfw && appath="$(fw_resolve_app "$exe")"; then
          if socketfw_add_rule "$appath" "$action"; then
            mark_set "Windows program-scoped rule: applied through the macOS Application Firewall. $name (${action} ${dirl}, app '$(basename "$appath")')"
          else
            mark_manual "fw: $name" "program-scoped ('${exe}'); socketfilterfw rejected it - add '$(basename "$appath")' by hand in System Settings > Network > Firewall > Options"
          fi
        elif [ -n "$exe" ]; then
          mark_manual "fw: $name" "program-scoped ('${exe}') but no matching application is installed on this Mac yet; add it in System Settings > Network > Firewall > Options after installing it"
        else
          mark_manual "fw: $name" "Windows rule opens ANY port (proto='${proto:-Any}', dir='${dir}') with no specific program; a blanket allow is too broad to apply automatically - review manually"
        fi
        continue ;;
    esac

    # Which transport(s) to open. 'Any' protocol with a real port -> both TCP and UDP.
    # ICMP / GRE / other port-less protocols cannot be expressed as port rules; macOS uses
    # its own sensible defaults for those, so report instead of failing.
    case "$proto" in
      tcp|udp) protos="$proto" ;;
      any|"")  protos="tcp udp" ;;
      *)       mark_manual "fw: $name" "protocol '${proto}' is not port-based (e.g. ICMP/GRE); not applied - macOS keeps its defaults for this"; continue ;;
    esac

    # Apply each port element separately (a Windows value can be a list like "1900,2869"
    # or a range like "49152-65535"), across each transport. This avoids any pf multi-port
    # syntax quirk; fw_apply_one translates the range separator.
    applied=0; problem=""; unportable=""; oldifs="$IFS"
    IFS=','
    for p in $port; do
      IFS="$oldifs"
      e="$(printf '%s' "$p" | tr -d '[:space:]')"; [ -z "$e" ] && continue
      # A still-non-numeric value here is a Windows-specific service keyword (e.g. a Cast/
      # WSD/RPC keyword fw_port_alias does not know) with no portable macOS port -- that is
      # a SKIP, not a failure. Only a real backend rejection below counts as a failure.
      case "$e" in *[!0-9-]*|-*|*-|*-*-*) unportable="Windows service-keyword port '$e' has no portable macOS equivalent"; break ;; esac
      for pp in $protos; do
        if fw_apply_one "$e" "$pp" "$action" "$dirl"; then applied=$((applied+1))
        else problem="${LAST_ERR:-could not buffer the pf rule for ${e}/${pp}}"; break; fi
      done
      [ -n "$problem" ] && break
    done
    IFS="$oldifs"

    if [ -n "$problem" ]; then
      mark_fail "fw: $name" "$problem (port='${port}', proto='${proto}')"
    elif [ -n "$unportable" ] && [ "$applied" -eq 0 ]; then
      mark_skip "fw: $name" "$unportable"
    elif [ "$applied" -gt 0 ]; then
      mark_set "fw: $name (${action} ${dirl} ${port}/${proto})"
    else
      record_line LOG "fw: $name" "nothing to apply (port='${port}', proto='${proto}')"
    fi
  done <<EOF
$(printf '%s\n' "$FIREWALL_DATA")
EOF

  # Write + load the port rules so the transferred ruleset takes effect regardless of
  # the prompt below.
  pf_install_anchor
  local nrules; nrules="$(wc -l < "$PF_RULES_TMP" 2>/dev/null | tr -d ' ')"
  [ "${nrules:-0}" -gt 0 ] && info "$nrules pf port rule(s) written to $PF_ANCHOR_FILE"
  rm -f "$PF_RULES_TMP" 2>/dev/null || true

  # Ask (in yellow) whether to enable + start the firewall now.
  if [ -r /dev/tty ]; then
    local enablecmd="/usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on; pfctl -e"
    warn "Firewall rules transferred. Do you want to enable and start the firewall now?"
    warn "If you feel it might break something you can skip it now."
    warn "You can always do that by executing sudo $enablecmd (y/n)"
    local ans; printf '  (y/n): ' > /dev/tty; read -r ans < /dev/tty || ans="n"
    case "$ans" in
      [Yy]*)
        local good=0
        if ensure_socketfw; then
          capture "$SOCKETFW" --setglobalstate on >/dev/null 2>&1 && good=1
          "$SOCKETFW" --setstealthmode on >/dev/null 2>&1 || true
        fi
        pfctl -e >/dev/null 2>&1 || true    # "pf already enabled" is not an error
        if [ "$good" = "1" ]; then mark_set "firewall enabled (Application Firewall + pf)"
        else mark_fail "firewall enable" "${LAST_ERR:-could not enable the macOS Application Firewall}"; fi ;;
      *)     info "firewall left as-is; enable later with: sudo $enablecmd" ;;
    esac
  fi
}

# =============================================================================
#  POST-INSTALL phase  (runs AFTER apps are installed)
# =============================================================================
# Where C_detect staged the user's personal files. apply_settings.sh lives in
# submodules/, so its grandparent dir is "Execute on macOS!" -> migrated_user_data.
MIGRATE_STAGE="${MIGRATE_STAGE:-$(dirname "$(cd "$(dirname "$0")" && pwd)")/migrated_user_data}"

# Find an installed application bundle by matching a Windows shortcut name / exe base.
# Echoes the full path to the .app (e.g. "/Applications/VLC.app") or nothing.
resolve_app() {  # resolve_app "Display Name" "exebase"
  local disp="$1" exe="$2" d app base nlow elow
  nlow="$(printf '%s' "$disp" | tr '[:upper:]' '[:lower:]' | tr -d ' ')"
  elow="$(printf '%s' "${exe%.exe}" | tr '[:upper:]' '[:lower:]' | tr -d ' ')"
  # 1) exact-ish match on the bundle name, for both the display name and the exe base.
  for d in "$APPS_DIR" "$(user_apps_dir)" "$APPS_DIR/Utilities" /System/Applications; do
    [ -d "$d" ] || continue
    for app in "$d"/*.app; do
      [ -d "$app" ] || continue
      base="$(basename "$app" .app | tr '[:upper:]' '[:lower:]' | tr -d ' ')"
      [ -n "$nlow" ] && [ "$base" = "$nlow" ] && { printf '%s' "$app"; return 0; }
      [ -n "$elow" ] && [ "$base" = "$elow" ] && { printf '%s' "$app"; return 0; }
    done
  done
  # 2) prefix match (e.g. "Visual Studio Code" for exe base "code" is NOT wanted, but
  #    "Google Chrome" for display name "Google Chrome" with a version suffix is).
  for d in "$APPS_DIR" "$(user_apps_dir)"; do
    [ -d "$d" ] || continue
    for app in "$d"/*.app; do
      [ -d "$app" ] || continue
      base="$(basename "$app" .app | tr '[:upper:]' '[:lower:]' | tr -d ' ')"
      [ -n "$nlow" ] && case "$base" in "$nlow"*) printf '%s' "$app"; return 0 ;; esac
    done
  done
  return 1
}

# Find the actual executable for a Windows shortcut's exe base name, e.g. "vlc" ->
# "/opt/homebrew/bin/vlc". Used only as a fallback when no .app bundle exists, so a
# desktop shortcut can become a valid symlink to the real binary instead of nothing.
resolve_binary() {  # resolve_binary "exebase"  -> echoes absolute path, or returns 1
  local exe="${1%.exe}" p d
  [ -n "$exe" ] || return 1
  if p="$(command -v "$exe" 2>/dev/null)" && [ "${p#/}" != "$p" ]; then
    printf '%s' "$p"; return 0
  fi
  for d in /opt/homebrew/bin /usr/local/bin /usr/bin /bin /opt/local/bin /usr/sbin /sbin; do
    [ -x "$d/$exe" ] && { printf '%s' "$d/$exe"; return 0; }
  done
  return 1
}

# Pin an application to the Dock, idempotently. dockutil is the reliable tool; without
# it we append to com.apple.dock persistent-apps by hand and restart the Dock.
add_favorite() {  # add_favorite "/Applications/Something.app"
  local app="$1" name cur
  [ -d "$app" ] || { mark_skip "dock: $app" "application not found"; return 0; }
  name="$(basename "$app" .app)"
  cur="$(dread com.apple.dock persistent-apps)"
  case "$cur" in *"$app"*) mark_skip "dock: $name" "already pinned"; return 0 ;; esac
  if have_cmd dockutil; then
    if capture run_as_user dockutil --add "$app" --no-restart; then
      run_as_user killall Dock >/dev/null 2>&1 || true
      mark_set "dock pinned: $name"; return 0
    fi
  fi
  # Fallback: append the tile dictionary directly.
  local tile="<dict><key>tile-data</key><dict><key>file-data</key><dict><key>_CFURLString</key><string>${app}</string><key>_CFURLStringType</key><integer>0</integer></dict></dict></dict>"
  if capture run_as_user defaults write com.apple.dock persistent-apps -array-add "$tile"; then
    run_as_user killall Dock >/dev/null 2>&1 || true
    mark_set "dock pinned: $name"
  else
    mark_fail "dock: $name" "${LAST_ERR:-could not update com.apple.dock persistent-apps}"
  fi
}

apply_shortcuts() {
  [ -z "$(printf '%s' "$SHORTCUTS_DATA" | tr -d '[:space:]')" ] && return 0
  log "Shortcuts (Quick Launch / Start menu / Desktop) -> installed apps"
  local kind disp exe app
  while IFS="$(printf '\t')" read -r kind disp exe; do
    [ -z "$disp$exe" ] && continue
    app="$(resolve_app "$disp" "$exe")" || app=""
    case "$kind" in
      desktop)
        mkdir -p "$TARGET_HOME/Desktop"
        if [ -n "$app" ]; then
          # A symlink to a .app opens the application from the Desktop exactly like an
          # alias does, and unlike an alias it can be created without the Finder.
          local link="$TARGET_HOME/Desktop/$(basename "$app" .app)"
          if [ -e "$link" ] || [ -L "$link" ]; then mark_skip "desktop shortcut: $disp" "already on the Desktop"; continue; fi
          if ln -sfn "$app" "$link" 2>/dev/null; then
            chown -h "$TARGET_USER":"$TARGET_GROUP" "$link" 2>/dev/null || true
            mark_set "desktop shortcut: $disp -> $app"
          else mark_fail "desktop shortcut: $disp" "could not create the link in ~/Desktop"; fi
        else
          # Fallback: no .app exists, so link to the real binary instead of leaving
          # nothing (and NEVER a Windows .lnk). Skips only if no binary can be found.
          local bin name link
          if bin="$(resolve_binary "$exe")"; then
            name="$(printf '%s' "${disp:-$exe}" | tr '/' '-')"
            link="$TARGET_HOME/Desktop/$name"
            if ln -sfn "$bin" "$link" 2>/dev/null; then
              chown -h "$TARGET_USER":"$TARGET_GROUP" "$link" 2>/dev/null || true
              mark_set "desktop shortcut: $disp -> $bin (symlink)"
            else mark_fail "desktop shortcut: $disp" "could not create a symlink in ~/Desktop"; fi
          else
            mark_skip "desktop shortcut: ${disp:-$exe}" "no installed app or binary found (skipped to avoid a broken link)"
          fi
        fi ;;
      quicklaunch|startmenu)
        [ -n "$app" ] && add_favorite "$app" || mark_skip "shortcut: ${disp:-$exe}" "no installed equivalent to pin to the Dock" ;;
      *) mark_skip "shortcut: $disp" "unknown kind '$kind'" ;;
    esac
  done <<EOF
$(printf '%s\n' "$SHORTCUTS_DATA")
EOF
}

# Record a note ONLY in the results log file -- not on screen, not in the printed
# summary (print_* ignores the NOTE status). Used for startup items / services with
# no macOS equivalent: harmless misses the user said "do not and cannot matter".
log_note() { record_line NOTE "$1" "${2:-}"; }

# Write a launchd property list. Used for both system daemons and user agents.
write_launchd_plist() {  # write_launchd_plist PATH LABEL PROGRAM [EXTRA_XML]
  local path="$1" label="$2" prog="$3" extra="${4:-}"
  mkdir -p "$(dirname "$path")" 2>/dev/null || return 1
  {
    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
    printf '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
    printf '<plist version="1.0"><dict>\n'
    printf '  <key>Label</key><string>%s</string>\n' "$label"
    printf '  <key>ProgramArguments</key><array>\n'
    printf '    <string>/bin/sh</string><string>-c</string><string>%s</string>\n' "$prog"
    printf '  </array>\n'
    printf '%s' "$extra"
    printf '</dict></plist>\n'
  } > "$path" 2>/dev/null || return 1
  plutil -lint "$path" >/dev/null 2>&1 || { rm -f "$path"; return 1; }
  chmod 0644 "$path" 2>/dev/null || true
  return 0
}

# Startup items -> macOS login items / LaunchDaemons, but ONLY when they resolve to an
# installed application. Scope is preserved: Windows machine-wide -> a LaunchDaemon in
# /Library/LaunchDaemons (system); current user -> a login item (the native macOS
# "opens at login" mechanism). Non-resolving items are recorded log-only.
apply_startup_items() {
  [ -z "$(printf '%s' "$STARTUP_DATA" | tr -d '[:space:]')" ] && return 0
  log "Startup items -> login items / LaunchDaemons (resolved apps only)"
  local scope name exe app label plistp
  while IFS="$(printf '\t')" read -r scope name exe; do
    [ -z "$name$exe" ] && continue
    app="$(resolve_app "$name" "$exe")" || { log_note "startup: ${name:-$exe}" "no installed equivalent (left out; harmless)"; continue; }
    case "$scope" in
      system)
        label="com.migratetomacos.startup.$(slugify "${name:-$exe}")"
        plistp="/Library/LaunchDaemons/${label}.plist"
        if [ -f "$plistp" ]; then mark_skip "startup: $name" "already a LaunchDaemon"; continue; fi
        if is_dry_run; then mark_plan "startup ($scope): $name" "would create $plistp"; continue; fi
        if write_launchd_plist "$plistp" "$label" "open -a '$app'" '  <key>RunAtLoad</key><true/>
'; then
          launchctl load -w "$plistp" >/dev/null 2>&1 || launchctl bootstrap system "$plistp" >/dev/null 2>&1 || true
          mark_set "startup (system): $name -> LaunchDaemon $label"
        else mark_fail "startup: $name" "could not write $plistp"; fi ;;
      *)
        if run_as_user osascript -e 'tell application "System Events" to get the name of every login item' 2>/dev/null | grep -qi "$(basename "$app" .app)"; then
          mark_skip "startup: $name" "already a login item"; continue
        fi
        if is_dry_run; then mark_plan "startup ($scope): $name" "would add a login item for $app"; continue; fi
        if capture run_as_user osascript -e "tell application \"System Events\" to make login item at end with properties {path:\"$app\", hidden:false}"; then
          mark_set "startup (user): $name -> login item"
        else mark_fail "startup: $name" "${LAST_ERR:-could not add the login item}"; fi ;;
    esac
  done <<EOF
$(printf '%s\n' "$STARTUP_DATA")
EOF
}

# Auto-start Windows services -> enable the matching launchd job ONLY when a job whose
# label clearly matches exists (services are system scope). No match -> log-only note.
enable_services() {
  [ -z "$(printf '%s' "$SERVICES_DATA" | tr -d '[:space:]')" ] && return 0
  log "Auto-start services -> launchd (clear name matches only)"
  if ! have_cmd launchctl; then log_note "services" "launchctl not available"; return 0; fi
  local labels disp name key label
  # Every job launchd currently knows about, plus everything installed under the
  # standard daemon/agent directories (a disabled job is not in `launchctl list`).
  labels="$( { launchctl list 2>/dev/null | awk 'NR>1{print $3}';
               ls /Library/LaunchDaemons /Library/LaunchAgents 2>/dev/null | sed 's/\.plist$//'; } | sort -u )"
  while IFS="$(printf '\t')" read -r disp name; do
    [ -z "$disp$name" ] && continue
    # Normalize the Windows service name to a bare alpha token (drop arch/version/punct).
    key="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/x64|x86|amd64//g; s/[0-9]+//g; s/[^a-z]//g')"
    [ -z "$key" ] && { log_note "service: ${disp:-$name}" "no comparable name"; continue; }
    label="$(printf '%s\n' "$labels" | grep -iE "(^|\.)${key}$" | head -n1)"
    [ -z "$label" ] && { log_note "service: ${disp:-$name}" "no clearly-matching launchd job"; continue; }
    if launchctl list "$label" >/dev/null 2>&1; then mark_skip "service: $disp" "$label already loaded"; continue; fi
    if capture launchctl enable "system/$label" && capture launchctl kickstart -k "system/$label"; then
      mark_set "service: $disp -> enabled launchd job $label"
    else mark_fail "service: $disp" "${LAST_ERR:-could not enable $label}"; fi
  done <<EOF
$(printf '%s\n' "$SERVICES_DATA")
EOF
}

# Windows DaysOfWeek bitmask (Sun=1,Mon=2,...,Sat=64) -> launchd Weekday numbers (Sun=0..Sat=6).
win_mask_to_weekdays() {  # win_mask_to_weekdays MASK -> space-separated weekday numbers
  local m="$1" out="" dow
  case "$m" in ''|*[!0-9]*) printf ''; return 0 ;; esac
  for dow in 0 1 2 3 4 5 6; do
    [ $(( m & (1 << dow) )) -ne 0 ] && out="${out:+$out }$dow"
  done
  printf '%s' "$out"
}

# Manually-created Windows scheduled tasks -> launchd jobs (the macOS scheduler), ONLY
# when the task's program resolves to an installed app/binary. Scope: user task -> a
# LaunchAgent in ~/Library/LaunchAgents; system task -> a LaunchDaemon in
# /Library/LaunchDaemons. Non-resolving / non-portable tasks are log-only.
apply_scheduled_tasks() {
  [ -z "$(printf '%s' "$SCHEDTASKS_DATA" | tr -d '[:space:]')" ] && return 0
  log "Scheduled tasks -> launchd (resolved programs only)"
  if ! have_cmd launchctl; then log_note "scheduled tasks" "launchctl not available"; return 0; fi
  local name scope sched exe cmd app label plistp extra hh mm mask hm rest d uid
  uid="$(id -u "$TARGET_USER" 2>/dev/null)"
  while IFS="$(printf '\t')" read -r name scope sched exe; do
    [ -z "$name$exe" ] && continue
    # Resolve a runnable command: a binary on PATH, else "open -a" the resolved app.
    cmd=""
    if [ -n "$exe" ] && cmd="$(resolve_binary "$exe")"; then :
    elif app="$(resolve_app "$name" "$exe")"; then cmd="/usr/bin/open -a '$app'"
    fi
    [ -z "$cmd" ] && { log_note "scheduled task: $name" "no installed program to run (skipped)"; continue; }
    # Build the launchd schedule (10# forces base-10 so 08/09 don't read as bad octal).
    extra=""
    case "$sched" in
      daily,*)
        hm="${sched#daily,}"; hh="${hm%%,*}"; mm="${hm##*,}"
        extra="$(printf '  <key>StartCalendarInterval</key>\n  <dict><key>Hour</key><integer>%d</integer><key>Minute</key><integer>%d</integer></dict>\n' "$((10#${hh:-0}))" "$((10#${mm:-0}))")" ;;
      weekly,*)
        rest="${sched#weekly,}"; mask="${rest%%,*}"; hm="${rest#*,}"; hh="${hm%%,*}"; mm="${hm##*,}"
        extra='  <key>StartCalendarInterval</key>
  <array>
'
        for d in $(win_mask_to_weekdays "$mask"); do
          extra="$extra$(printf '    <dict><key>Weekday</key><integer>%d</integer><key>Hour</key><integer>%d</integer><key>Minute</key><integer>%d</integer></dict>\n' "$d" "$((10#${hh:-0}))" "$((10#${mm:-0}))")"
        done
        extra="$extra
  </array>
" ;;
      onstart|onlogon) extra='  <key>RunAtLoad</key><true/>
' ;;
      *) log_note "scheduled task: $name" "trigger '$sched' is not portable to launchd (skipped)"; continue ;;
    esac
    label="com.migratetomacos.task.$(slugify "$name")"
    case "$scope" in
      system) plistp="/Library/LaunchDaemons/${label}.plist" ;;
      *)      plistp="$TARGET_HOME/Library/LaunchAgents/${label}.plist" ;;
    esac
    if [ -f "$plistp" ]; then mark_skip "scheduled task: $name" "already scheduled ($label)"; continue; fi
    if is_dry_run; then mark_plan "scheduled task ($scope): $name" "would create $plistp"; continue; fi
    if write_launchd_plist "$plistp" "$label" "$cmd" "$extra"; then
      if [ "$scope" = "system" ]; then
        launchctl load -w "$plistp" >/dev/null 2>&1 || launchctl bootstrap system "$plistp" >/dev/null 2>&1 || true
      else
        own "$plistp"
        launchctl bootstrap "gui/$uid" "$plistp" >/dev/null 2>&1 || run_as_user launchctl load -w "$plistp" >/dev/null 2>&1 || true
      fi
      mark_set "scheduled task ($scope): $name -> launchd [$label] $cmd"
    else mark_fail "scheduled task: $name" "could not write $plistp"; fi
  done <<EOF
$(printf '%s\n' "$SCHEDTASKS_DATA")
EOF
}

# C_detect packs the user's personal files into ONE encrypted archive next to the
# staging dir: "<migrated_user_data>.tar.enc" (AES-256-CBC / PBKDF2, same transfer
# password as WiFi). Decrypt + extract it ONCE into a private temp dir; copy_ssh and
# copy_contacts then read from there. STAGE_DIR is the dir they read; STAGE_TMP is
# cleaned up afterwards. If no archive but a plaintext staging dir exists (standalone
# / legacy), use that directly.
STAGE_DIR=""; STAGE_TMP=""
unpack_stage() {
  local archive="${MIGRATE_STAGE}.tar.enc" ob
  if [ ! -f "$archive" ]; then
    [ -d "$MIGRATE_STAGE" ] && [ -n "$(ls -A "$MIGRATE_STAGE" 2>/dev/null)" ] && STAGE_DIR="$MIGRATE_STAGE"
    return 0
  fi
  if ! openssl_has_pbkdf2; then
    ask_install_addition "personal data" "openssl@3" "decrypt your transferred SSH keys / Contacts / wallpaper" \
      || { mark_skip "personal data" "no PBKDF2-capable openssl to decrypt the archive"; return 0; }
    OPENSSL_BIN=""
  fi
  ob="$(openssl_bin 2>/dev/null)" || { mark_skip "personal data" "openssl unavailable to decrypt the archive"; return 0; }
  if ! have_cmd tar; then mark_skip "personal data" "tar unavailable to extract the archive"; return 0; fi
  # The decryption password was collected once, up front (ask_xfer_password); reuse it.
  local key="$MIGRATE_XFER_PWD"
  [ -z "$key" ] && { mark_skip "personal data" "no decryption password given (personal data skipped)"; return 0; }
  STAGE_TMP="$(mktemp -d -t mtm_stage 2>/dev/null || echo /tmp/mtm_stage.$$)"; mkdir -p "$STAGE_TMP"
  if "$ob" enc -d -aes-256-cbc -pbkdf2 -salt -pass pass:"$key" -in "$archive" 2>/dev/null | tar -xf - -C "$STAGE_TMP" 2>/dev/null; then
    STAGE_DIR="$STAGE_TMP"
  else
    rm -rf "$STAGE_TMP" 2>/dev/null || true; STAGE_TMP=""
    mark_fail "personal data" "could not decrypt the archive (wrong password?) - SSH/Contacts skipped"
  fi
}

cleanup_stage() {
  [ -n "$STAGE_TMP" ] && rm -rf "$STAGE_TMP" 2>/dev/null || true
}

copy_ssh() {
  local src="$STAGE_DIR/ssh"
  [ -n "$STAGE_DIR" ] && [ -d "$src" ] && [ -n "$(ls -A "$src" 2>/dev/null)" ] || return 0
  log "SSH keys / config -> ~/.ssh"
  local dest="$TARGET_HOME/.ssh" f base out
  mkdir -p "$dest"; chmod 700 "$dest" 2>/dev/null || true
  for f in "$src"/*; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    out="$dest/$base"
    [ -e "$out" ] && { mark_skip "ssh: $base" "already exists (left untouched)"; continue; }
    if cp -f "$f" "$out" 2>/dev/null; then
      own "$out"
      case "$base" in *.pub|config|known_hosts|authorized_keys) chmod 644 "$out" 2>/dev/null || true ;; *) chmod 600 "$out" 2>/dev/null || true ;; esac
      mark_set "ssh file: $base"
    else mark_fail "ssh: $base" "could not copy into ~/.ssh"; fi
  done
  own "$dest"
}

copy_contacts() {
  local src="$STAGE_DIR/contacts"
  [ -n "$STAGE_DIR" ] && [ -d "$src" ] && [ -n "$(ls -A "$src" 2>/dev/null)" ] || return 0
  log "Contacts -> ~/Documents/Migrated Contacts"
  # macOS keeps its address book in a sealed database, so the files are staged where the
  # user can import them: Contacts.app reads .vcf directly (File > Import), and a Windows
  # .contact file is XML that needs converting first.
  local dest="$TARGET_HOME/Documents/Migrated Contacts"
  mkdir -p "$dest"
  if cp -R "$src"/. "$dest"/ 2>/dev/null; then
    own -R "$dest"
    if ls "$dest"/*.vcf >/dev/null 2>&1; then
      mark_set "contacts copied to ~/Documents/Migrated Contacts (open Contacts.app and use File > Import to load the .vcf files)"
    else
      mark_set "contacts copied to ~/Documents/Migrated Contacts (.contact files are Windows XML - convert them to .vcf, then import with Contacts.app > File > Import)"
    fi
  else
    mark_fail "contacts" "could not copy into ~/Documents/Migrated Contacts"
  fi
}

# Fonts are NOT migrated in the staged archive (they would bloat it by hundreds of MB).
# Instead, manual-install style: tell the user where to get fonts and ask for a directory
# (local path, or a mounted SMB/NFS share) of unzipped font files; search it <=3 levels
# deep and install every valid font found. Loops so several directories can be added.
install_fonts() {
  log "Custom fonts"
  is_dry_run && { mark_plan "fonts" "would prompt for a font directory to install from"; return 0; }
  if [ ! -r /dev/tty ]; then mark_skip "fonts" "no terminal to ask for a font directory"; return 0; fi
  local dest="$TARGET_HOME/Library/Fonts" dir ans f n total=0
  info "Fonts are not auto-transferred. To bring your Windows fonts over:"
  info "  1) On Windows, copy the font files you want from %LOCALAPPDATA%\\Microsoft\\Windows\\Fonts"
  info "     and/or %SYSTEMROOT%\\Fonts  (i.e. C:\\Windows\\Fonts)  -- unzip them if they are zipped."
  info "  2) Put them in a directory reachable from THIS Mac: a local folder, or a mounted"
  info "     SMB/AFP/NFS share (e.g. /Volumes/share)."
  info "  3) Enter that directory path below; it is searched recursively (up to 3 levels deep)"
  info "     and every .ttf/.otf/.ttc font found is installed into ~/Library/Fonts."
  mkdir -p "$dest"
  while :; do
    printf "  Font directory ('path' to install / d=done when finished / s=skip to skip fonts): " > /dev/tty
    read -r ans < /dev/tty || ans="skip"
    case "$ans" in
      [Ss]|[Ss][Kk][Ii][Pp]) [ "$total" -eq 0 ] && mark_skip "fonts" "user skipped"; break ;;
      [Dd]|[Dd][Oo][Nn][Ee]) break ;;
      *)
        dir="$(resolve_user_path "$ans")"
        if [ -z "$dir" ] || [ ! -d "$dir" ]; then
          printf "\033[1;31m  Not a readable directory: '%s' -- enter a valid path, 'done', or 'skip'.\033[0m\n" "${dir:-$ans}" > /dev/tty; continue
        fi
        n=0
        while IFS= read -r f; do
          [ -f "$f" ] || continue
          [ -e "$dest/$(basename "$f")" ] || cp -f "$f" "$dest/" 2>/dev/null && n=$((n+1))
        done <<EOF
$(find "$dir" -maxdepth 3 -type f \( -iname '*.ttf' -o -iname '*.otf' -o -iname '*.ttc' -o -iname '*.otc' -o -iname '*.dfont' \) 2>/dev/null)
EOF
        if [ "$n" -gt 0 ]; then total=$((total+n)); info "installed $n font(s) from $dir"
        else printf "\033[1;33m  No font files found under '%s' (searched 3 levels deep).\033[0m\n" "$dir" > /dev/tty; fi
        ;;
    esac
  done
  if [ "$total" -gt 0 ]; then
    own -R "$dest"
    mark_set "fonts: installed $total font file(s) into ~/Library/Fonts"
  fi
}

apply_wallpaper() {
  local src="$STAGE_DIR/wallpaper"
  [ -n "$STAGE_DIR" ] && [ -d "$src" ] && [ -n "$(ls -A "$src" 2>/dev/null)" ] || return 0
  log "Wallpaper -> desktop background"
  local img="" dest f
  for f in "$src"/*; do [ -f "$f" ] && { img="$f"; break; }; done
  [ -z "$img" ] && return 0
  dest="$TARGET_HOME/Pictures/Wallpapers/$(basename "$img")"
  mkdir -p "$(dirname "$dest")"
  if cp -f "$img" "$dest" 2>/dev/null; then
    own -R "$TARGET_HOME/Pictures/Wallpapers"
    if capture run_as_user osascript -e "tell application \"System Events\" to set picture of every desktop to \"$dest\""; then
      mark_set "wallpaper = $dest"
    else
      mark_manual "wallpaper" "set $dest as your wallpaper in System Settings > Wallpaper"
    fi
  else mark_fail "wallpaper" "could not copy the image"; fi
}

apply_default_browser() {
  [ -z "${CFG_default_browser:-}" ] && return 0
  log "Default web browser: ${CFG_default_browser}"
  # Candidate bundle names per browser token, first installed one wins.
  local cands="" app="" c d
  case "$CFG_default_browser" in
    chrome)  cands="Google Chrome|Chromium" ;;
    firefox) cands="Firefox|Firefox Developer Edition" ;;
    edge)    cands="Microsoft Edge" ;;
    brave)   cands="Brave Browser" ;;
    opera)   cands="Opera" ;;
    safari)  cands="Safari" ;;
    *)       cands="$CFG_default_browser" ;;
  esac
  local oldifs="$IFS"; IFS='|'
  for c in $cands; do
    IFS="$oldifs"
    for d in "$APPS_DIR" "$(user_apps_dir)" /System/Applications /Applications; do
      [ -d "$d/$c.app" ] && { app="$d/$c.app"; break 2; }
    done
  done
  IFS="$oldifs"
  [ -z "$app" ] && { mark_skip "default browser" "${CFG_default_browser} is not installed"; return 0; }
  # macOS has no supported CLI for this; `defaultbrowser` is the community standard.
  if ! have_cmd defaultbrowser; then
    ask_install_addition "default browser" "defaultbrowser" "set the default web browser from the command line" \
      || { mark_manual "default browser" "set $(basename "$app" .app) as the default in System Settings > Desktop & Dock > Default web browser"; return 0; }
  fi
  if have_cmd defaultbrowser; then
    local token; token="$(printf '%s' "$(basename "$app" .app)" | tr '[:upper:]' '[:lower:]' | tr -d ' ')"
    if capture run_as_user defaultbrowser "$token"; then mark_set "default browser = $(basename "$app" .app)"
    else mark_manual "default browser" "set $(basename "$app" .app) as the default in System Settings > Desktop & Dock > Default web browser"; fi
  else
    mark_manual "default browser" "set $(basename "$app" .app) as the default in System Settings > Desktop & Dock > Default web browser"
  fi
}

run_pre() {
  apply_display_scaling
  apply_resolution
  apply_mouse
  apply_appearance
  apply_touchpad
  apply_power_timeouts
  apply_lock_timeout
  apply_keyboard_layout
  apply_accessibility
  apply_locale
  apply_proxy
  disable_telemetry_location
  apply_timezone_timesync
  apply_wifi
  apply_firewall
  apply_hosts
  apply_printers
  apply_netcfg
  apply_lid_behavior
  info "Note: Windows keyboard shortcuts map to their macOS equivalents (Ctrl -> Command"
  info "      for copy/paste/save, Shift+Command+4 for a screenshot, and so on); review"
  info "      System Settings > Keyboard > Keyboard Shortcuts if you want to change them."
}

run_post() {
  apply_shortcuts
  apply_startup_items
  enable_services
  apply_scheduled_tasks
  unpack_stage
  copy_ssh
  copy_contacts
  apply_wallpaper
  cleanup_stage
  install_fonts
  apply_default_browser
}

main() {
  require_root
  detect_os
  detect_arch
  detect_de
  MODULE="Config settings"
  # Phase: pre (before apps), post (after apps), or all (standalone). Default all.
  local phase="${1:-all}"
  log "Migrate to macOS  --  Apply Settings (${phase})"
  info "macOS        : ${OS_VERSION} (${OS_CODENAME})"
  info "Architecture : ${ARCH} (${ARCH_LABEL})"

  # Decryption password for sensitive exported data (WiFi/SSH/Contacts/wallpaper) shares
  # one answer; ask once up front. In an orchestrated run execute_all already asked and
  # exported it, so this is a no-op there.
  ask_xfer_password

  case "$phase" in
    pre)  run_pre ;;
    post) run_post ;;
    *)    run_pre; run_post ;;
  esac

  print_summary
}

main "$@"
