#!/usr/bin/env bash
# =============================================================================
#  install_device_drivers.sh
#  GENERATED by submodules/D_compile_and_generate_shell_script.ps1 -- do not edit.
#
#  Device drivers on macOS are part of the operating system: Apple ships the
#  graphics, Wi-Fi, Bluetooth, audio, storage and input drivers in the OS itself
#  and updates them through Software Update, so there is nothing to "install" for
#  the built-in hardware.  What this stage DOES do:
#    * makes sure the OS-supplied drivers are current (softwareupdate)
#    * installs Rosetta 2 on Apple Silicon (needed by Intel-only software)
#    * reports the graphics / network / audio hardware macOS actually detected
#    * reports third-party kernel extensions and system extensions already loaded
#    * enables printing + scanning (CUPS is built in) and offers the vendor
#      drivers for the peripherals macOS does NOT cover out of the box
#      (USB-to-serial bridges, tablets, some printers/scanners)
#    * lists the Windows devices detected on the source machine for reference
#  Works on every supported macOS release and on both Apple Silicon and Intel.
# =============================================================================
### __COMMON__ ###

update_os_drivers() {
  log "Apple-supplied drivers & firmware (Software Update)"
  have_cmd softwareupdate || { mark_skip "driver updates" "softwareupdate is not available"; return 0; }
  local list
  list="$(softwareupdate -l 2>&1 | grep -E '^\s+\*' || true)"
  if [ -z "$list" ]; then
    mark_skip "driver updates" "already up to date (macOS ships and updates the hardware drivers itself)"
    return 0
  fi
  info "Software Update has pending items (these include driver/firmware updates):"
  printf '%s\n' "$list" | while IFS= read -r l; do info "  $l"; done
  if [ -r /dev/tty ] && ! is_dry_run; then
    local ans
    printf '  Install the pending macOS updates now? This can take a while and may reboot the Mac (y/n): ' > /dev/tty
    read -r ans < /dev/tty || ans="n"
    case "$ans" in
      [Yy]*) if capture softwareupdate -ia --agree-to-license; then mark_ok "macOS driver/firmware updates"
             else mark_fail "macOS driver/firmware updates" "${LAST_ERR:-softwareupdate failed}"; fi ;;
      *)     mark_skip "driver updates" "user chose to install them later (run: sudo softwareupdate -ia)" ;;
    esac
  else
    mark_manual "driver updates" "run 'sudo softwareupdate -ia' to install the pending macOS driver/firmware updates"
  fi
}

install_rosetta() {
  [ "$ARCH" = "arm64" ] || { mark_skip "Rosetta 2" "not needed on Intel Macs"; return 0; }
  log "Rosetta 2 (runs Intel-only macOS software on Apple Silicon)"
  if /usr/bin/pgrep -q oahd 2>/dev/null || [ -d /Library/Apple/usr/libexec/oah ]; then
    mark_skip "Rosetta 2" "already installed"; return 0
  fi
  if ensure_rosetta; then mark_ok "Rosetta 2"
  else mark_fail "Rosetta 2" "softwareupdate --install-rosetta failed (run it manually)"; fi
}

report_graphics() {
  log "Graphics"
  local gpu
  gpu="$(system_profiler SPDisplaysDataType 2>/dev/null | awk -F': ' '/Chipset Model|Vendor|VRAM|Metal/{gsub(/^ +/,"",$0); print}')"
  [ -n "$gpu" ] && printf '%s\n' "$gpu" | while IFS= read -r l; do info "$l"; done
  case "$ARCH" in
    arm64)
      info "Apple Silicon GPU -> the driver is part of macOS; nothing to install."
      info "NVIDIA and AMD add-in cards are not supported on Apple Silicon Macs." ;;
    *)
      info "Intel Mac -> the Intel/AMD graphics driver is part of macOS; nothing to install."
      info "NVIDIA web drivers ended with macOS High Sierra, so an NVIDIA card cannot be"
      info "driven on High Sierra or newer; AMD cards (incl. eGPU) are supported in-OS." ;;
  esac
  mark_skip "graphics driver" "already provided by macOS (updated through Software Update)"
}

report_extensions() {
  log "Third-party kernel / system extensions already on this Mac"
  local kexts sysext
  kexts="$(kmutil showloaded --collection-kind auxiliary 2>/dev/null | awk 'NR>1 && $6!~/^com\.apple\./{print $6}' | sort -u)"
  [ -z "$kexts" ] && kexts="$(kextstat 2>/dev/null | awk '$6!~/^com\.apple\./{print $6}' | sort -u)"
  if [ -n "$kexts" ]; then
    info "Loaded third-party kernel extensions (each needs approval in System Settings > Privacy & Security):"
    printf '%s\n' "$kexts" | while IFS= read -r k; do [ -n "$k" ] && info "  - $k"; done
  else
    info "No third-party kernel extensions are loaded (normal on a fresh Mac)."
  fi
  sysext="$(systemextensionsctl list 2>/dev/null | grep -vE '^\s*$|^[0-9]+ extension' | tail -n +2)"
  [ -n "$sysext" ] && { info "System extensions:"; printf '%s\n' "$sysext" | while IFS= read -r s; do info "  $s"; done; }
  mark_skip "kernel extensions" "reported for reference (macOS 11+ prefers DriverKit system extensions over kexts)"
}

install_printing() {
  log "Printer / scanner support"
  # CUPS *is* macOS printing: lpadmin/lpstat/cupsd are part of the OS, so there is
  # nothing to install. AirPrint and IPP Everywhere cover most modern printers
  # driverless; only older/vendor-specific models need a driver package.
  if have_cmd lpadmin && have_cmd lpstat; then
    mark_skip "printing (CUPS)" "already built into macOS - add printers in System Settings > Printers & Scanners"
  else
    mark_fail "printing (CUPS)" "lpadmin/lpstat are missing, which should not happen on macOS"
  fi
  # Scanning: Image Capture + the ICA framework are built in; SANE is the answer only
  # for scanners with no macOS driver, so it is offered rather than forced.
  if have_cmd scanimage; then
    mark_skip "scanning (SANE)" "already installed"
  else
    info "Scanning works out of the box through Image Capture for most scanners."
    info "SANE is only needed for a scanner that has no macOS driver at all."
    if ask_install_addition "scanning (SANE)" "sane-backends" "support scanners that have no native macOS driver"; then
      mark_ok "scanning (SANE backends)"
    fi
  fi
}

# Peripherals macOS genuinely does NOT cover in-box. Each entry is offered only when a
# matching device is actually attached, so nothing pointless is installed.
#   USB vendor id -> "cask token|human name"
install_peripheral_drivers() {
  log "Peripheral drivers macOS does not include (offered only when the device is present)"
  local usb offered=0
  usb="$(system_profiler SPUSBDataType 2>/dev/null)"
  [ -z "$usb" ] && { mark_skip "peripheral drivers" "no USB device tree available"; return 0; }

  _offer_driver() {  # _offer_driver PATTERN CASK HUMAN
    local pat="$1" cask="$2" human="$3"
    printf '%s' "$usb" | grep -qiE "$pat" || return 0
    offered=1
    info "Detected: $human"
    if cask_installed "$cask"; then mark_skip "$human driver" "already installed"; return 0; fi
    if ask_install_addition "$human driver" "$cask" "let macOS talk to the attached $human"; then
      if ensure_cask && capture install_cask "$cask"; then mark_ok "$human driver" "cask $cask"
      else mark_fail "$human driver" "${LAST_ERR:-could not install the cask $cask}"; fi
    fi
  }

  # USB-to-serial bridges: macOS has in-box drivers for FTDI and Silicon Labs on recent
  # releases, but the vendor kext is still needed for older macOS and for CH34x/PL2303.
  _offer_driver '0x0403|FTDI'                     ftdi-vcp-driver              "FTDI USB-serial adapter"
  _offer_driver '0x1a86|CH340|CH341|QinHeng'      wch-ch34x-usb-serial-driver  "CH340/CH341 USB-serial adapter"
  _offer_driver '0x10c4|Silicon Labs|CP210'       silicon-labs-vcp-driver      "Silicon Labs CP210x USB-serial adapter"
  _offer_driver '0x067b|Prolific|PL2303'          prolific-pl2303-driver       "Prolific PL2303 USB-serial adapter"
  # Graphics tablets and audio interfaces ship their own macOS drivers.
  _offer_driver '0x056a|Wacom'                    wacom-tablet                 "Wacom graphics tablet"
  _offer_driver '0x0763|M-Audio|0x1235|Focusrite' loopback                     "professional audio interface"

  [ "$offered" -eq 0 ] && mark_skip "peripheral drivers" "every attached device is covered by the drivers built into macOS"
}

report_mac_hardware() {
  log "Hardware macOS detected on THIS Mac"
  local model chip mem l x net
  model="$(system_profiler SPHardwareDataType 2>/dev/null | awk -F': ' '/Model Name|Model Identifier/{gsub(/^ +/,"",$0); print}')"
  chip="$(system_profiler SPHardwareDataType 2>/dev/null | awk -F': ' '/Chip|Processor Name|Total Number of Cores/{gsub(/^ +/,"",$0); print}')"
  mem="$(system_profiler SPHardwareDataType 2>/dev/null | awk -F': ' '/Memory/{gsub(/^ +/,"",$0); print}')"
  for l in "$model" "$chip" "$mem"; do [ -n "$l" ] && printf '%s\n' "$l" | while IFS= read -r x; do info "$x"; done; done
  net="$(networksetup -listallhardwareports 2>/dev/null | awk '/Hardware Port/{gsub(/^Hardware Port: /,"",$0); print "  network: " $0}')"
  [ -n "$net" ] && printf '%s\n' "$net" | while IFS= read -r l; do info "$l"; done
}

list_source_drivers() {
  log "Windows devices detected on the source machine (reference only)"
  ### __DRIVERS_DATA__ ###
}

main() {
  require_root
  detect_os
  detect_arch
  MODULE="Drivers"
  log "Migrate to macOS  --  Device Drivers"
  info "macOS        : ${OS_VERSION} (${OS_CODENAME})"
  info "Architecture : ${ARCH} (${ARCH_LABEL})"
  info ""
  info "macOS ships its own hardware drivers, so most Windows drivers have no counterpart"
  info "to install here -- they are already part of the operating system."
  report_mac_hardware
  update_os_drivers
  install_rosetta
  report_graphics
  report_extensions
  install_printing
  install_peripheral_drivers
  list_source_drivers
  print_summary
}

main "$@"
