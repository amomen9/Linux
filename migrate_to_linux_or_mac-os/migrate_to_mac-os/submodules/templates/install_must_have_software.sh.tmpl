#!/usr/bin/env bash
# =============================================================================
#  install_must_have_software.sh
#  GENERATED by submodules/D_compile_and_generate_shell_script.ps1 -- do not edit.
#
#  Universal installer: detects the running macOS release (Catalina 10.15 through
#  the latest) and the CPU architecture (Apple Silicon arm64 / Intel x86_64) at
#  runtime, then installs each app Cask-first with a Homebrew-formula, Mac App
#  Store and direct-download fallback.  Runs unchanged on every supported macOS
#  version and on both architectures.
# =============================================================================
### __COMMON__ ###

main() {
  is_dry_run || require_root
  detect_os
  detect_arch
  MODULE="Applications"
  log "Migrate to macOS  --  Must-Have Software"
  is_dry_run && log "DRY-RUN (report only): no changes will be made."
  info "macOS          : ${OS_VERSION} (${OS_CODENAME})"
  info "Package manager: ${PM}"
  info "Architecture   : ${ARCH} (${ARCH_LABEL})"
  if ! is_dry_run; then
    ensure_brew || warn "Homebrew unavailable -- only Mac App Store and direct-download routes will work."
    pm_refresh
    ensure_cask || warn "Homebrew Cask unavailable -- Cask-only apps will be skipped."
  fi

  # ---------------------------------------------------------------------------
  # Application install list (generated from B_applications.json + the
  # Additional_Manual_macOS_Software_Requirments.csv).
  # ---------------------------------------------------------------------------
  ### __APPS_DATA__ ###

  print_summary
}

main "$@"
